# Copy to docker/.env and edit. docker/.env is gitignored.

# Image tag. Use the release version so a rollback is `PWA_IMAGE_TAG=<previous> docker compose up -d`.
PWA_IMAGE_TAG=1.0.3

# Host ports. 80 only redirects to HTTPS (and answers /healthz).
PWA_HTTP_PORT=80
PWA_HTTPS_PORT=443

# The name(s) or IP tablets type, space-separated ("abc.com 192.168.60.1"); "_" accepts any.
# Informational with the shipped template — one server block per port answers every name — so
# what actually has to list each name is the certificate's subjectAltName. The browser build
# follows whatever origin it is opened from; the APK uses the address in .env.mobile / Settings.
PWA_SERVER_NAME=_

# Where Spring Boot listens, as seen from inside the container. No trailing slash, no /api.
#   Backend on the Docker host:              http://host.docker.internal:8081
#   Backend in another container on the same compose network:  http://backend:8081
#   Backend on another machine:              http://10.0.0.5:8081
PWA_BACKEND_UPSTREAM=http://host.docker.internal:8081

# Largest request nginx forwards. Must stay above the backend's app.attachments.max-file-size-bytes (25 MB).
PWA_MAX_BODY_SIZE=32m

# How often ONE client address may call the endpoints that need no session: sign-in, the device
# challenge and device enrolment. nginx syntax — r/m is per minute, r/s per second. A sign-in
# from the APK is four requests (two calls, each with a CORS preflight), from a browser two.
# If every tablet reaches this server through one NAT address they all share the bucket: raise
# these until a shift change fits. A refused request gets 429 with a Persian message.
PWA_LOGIN_RATE=60r/m
PWA_LOGIN_BURST=30

# Access log format: json (one JSON object per line — what Filebeat → Logstash wants) or main
# (one line of text, for reading by eye). The logs are files in docker/logs/ — DEPLOY.md § "Logs".
PWA_LOG_FORMAT=json

# How much goes into error.log, from most to least: info, notice, warn, error, crit, alert, emerg.
# notice (the default) or warn suits production; info for chasing a TLS problem, then back.
# At error or above, rate-limit refusals (logged at warn) are no longer recorded. DEPLOY.md § "Logs".
PWA_ERROR_LOG_LEVEL=notice

# Time zone of the log timestamps (they include their offset either way).
PWA_TZ=Asia/Tehran

# Seconds a browser remembers "HTTPS only" for this name (HSTS). One year. 0 tells browsers to
# forget it. Has no effect when tablets use an IP address rather than a name, and none on the APK.
PWA_HSTS_MAX_AGE=31536000
