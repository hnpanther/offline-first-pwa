# Copy to docker/.env and edit. docker/.env is gitignored.

# Image tag. Use the release version so a rollback is `PWA_IMAGE_TAG=<previous> docker compose up -d`.
PWA_IMAGE_TAG=1.0.0

# Host ports. 80 only redirects to HTTPS (and answers /healthz).
PWA_HTTP_PORT=80
PWA_HTTPS_PORT=443

# The name or IP the tablets type. Must match VITE_SERVER_URL in .env.mobile, the certificate's
# subjectAltName, and the address the APK was built for. "_" accepts any.
PWA_SERVER_NAME=_

# Where Spring Boot listens, as seen from inside the container. No trailing slash, no /api.
#   Backend on the Docker host:              http://host.docker.internal:8081
#   Backend in another container on the same compose network:  http://backend:8081
#   Backend on another machine:              http://10.0.0.5:8081
PWA_BACKEND_UPSTREAM=http://host.docker.internal:8081

# Largest request nginx forwards. Must stay above the backend's app.attachments.max-file-size-bytes (25 MB).
PWA_MAX_BODY_SIZE=32m
