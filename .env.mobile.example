# Copy to .env.mobile before npm run build:mobile
#
# Production (nginx on 192.168.1.4, API proxied to 192.168.1.2:8081):
#   VITE_SERVER_URL=https://192.168.1.4
#
# Local dev preview (Vite on :4173):
#   VITE_SERVER_URL=https://<your-pc-lan-ip>:4173
#
# The nginx address — NOT the Spring host/port. It is the server a fresh APK install starts
# with (an administrator can change it later in Settings). The browser build ignores it: in a
# browser the app always talks to the origin it was opened from, so dist/ needs no rebuild when
# the site's name changes.
VITE_SERVER_URL=https://192.168.1.4
